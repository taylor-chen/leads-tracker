# Optional overrides for docker compose. Copy to `.env` and edit as needed.
# Everything has a working default, so this file is not required for local testing.

# Recipient of "new lead" notifications.
ATTORNEY_NOTIFICATION_EMAIL=attorney@example.com

# Attorney account created on backend startup (if it doesn't exist yet).
SEED_ATTORNEY_EMAIL=attorney@example.com
SEED_ATTORNEY_PASSWORD=changeme123
SEED_ATTORNEY_NAME=Alex Attorney

# Use a long random value outside local dev: `openssl rand -hex 32`
JWT_SECRET=local-dev-secret-change-me-in-production-please

EMAIL_FROM=Leads Tracker <no-reply@leads.local>
